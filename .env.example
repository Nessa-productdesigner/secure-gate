# Copy to .env.local and fill in real values. Never commit .env.local.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

NEXTAUTH_SECRET="generate-a-random-secret-at-least-32-characters"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

RESEND_API_KEY="re_your_key_from_resend.com"
RESEND_FROM_EMAIL="SecureGate <onboarding@resend.dev>"

# Optional — rate limiting (set both or leave both unset)
# UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-token"
